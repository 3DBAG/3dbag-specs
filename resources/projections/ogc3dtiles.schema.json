{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "3DBAG OGC 3D Tiles Projection Schema",
  "description": "Current Tyler EXT_structural_metadata contract per LoD tileset. Numeric properties are SCALAR with componentType and noData; STRING has no componentType in glTF. Semantic arrays are JSON strings (encoding json), booleans are INT8 0/1. Missing strings use empty strings; empty and null strings cannot be distinguished. Numeric noData sentinels are reserved. All three tilesets include all three val3dity attributes. Float values are rounded half-to-even per semantic precision in float64 before narrowing to FLOAT32. Values outside the declared component range or colliding with noData are invalid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "tilesets"
  ],
  "properties": {
    "format": {
      "const": "ogc3dtiles"
    },
    "tilesets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/tileset"
      }
    }
  },
  "definitions": {
    "tileset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "class",
        "properties"
      ],
      "properties": {
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lod"
          ],
          "properties": {
            "lod": {
              "type": "string",
              "enum": [
                "lod12",
                "lod13",
                "lod22"
              ]
            }
          }
        },
        "class": {
          "type": "string",
          "minLength": 1,
          "description": "EXT_structural_metadata class name, e.g. 'building'."
        },
        "properties": {
          "$ref": "#/definitions/attribute-map"
        }
      }
    },
    "attribute-map": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/definitions/attribute-entry"
      }
    },
    "attribute-entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentType"
      ],
      "properties": {
        "property": {
          "type": "string",
          "minLength": 1,
          "description": "Property name. Defaults to the semantic attribute name when absent."
        },
        "componentType": {
          "type": "string",
          "enum": [
            "INT8",
            "INT16",
            "INT32",
            "INT64",
            "UINT8",
            "UINT16",
            "UINT32",
            "UINT64",
            "FLOAT32",
            "FLOAT64",
            "STRING",
            "BOOLEAN"
          ]
        },
        "shape": {
          "type": "string",
          "enum": [
            "scalar",
            "array"
          ],
          "default": "scalar",
          "description": "'array' for semantic arrays represented natively; componentType then describes the items. STRING plus encoding 'json' represents arrays unsupported by the metadata shape."
        },
        "encoding": {
          "enum": [
            "json",
            "boolean-integer"
          ]
        },
        "noData": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        },
        "nullEncoding": {
          "enum": [
            "empty-string"
          ]
        }
      }
    }
  }
}
