{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "3DBAG GeoPackage Projection Schema",
  "description": "Projection of semantic 3DBAG attributes into GeoPackage. Containers: 'layer' (feature tables), 'semantics' and 'address' (named data tables that carry attribute values; only true GeoPackage system tables such as gpkg_* and rtree are structural and never appear here). 'layer' containers have 'name'; when the name is derived rather than fixed, 'selector' records the derivation input (cityObjectType, geometryFamily, lod) and cross-file tests verify the expansion. 'semantics'/'address' containers have a fixed 'table' and never a 'selector'. 'column' defaults to the semantic attribute name when absent. Physical types are GeoPackage/SQLite data types; arrays are stored as TEXT (JSON).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "containers"
  ],
  "properties": {
    "format": {
      "const": "gpkg"
    },
    "containers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/container"
      }
    }
  },
  "definitions": {
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "attributes"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "layer",
            "semantics",
            "address"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Feature table name. Required for kind 'layer'."
        },
        "table": {
          "type": "string",
          "minLength": 1,
          "description": "Fixed data table name. Required (and fixed) for kinds 'semantics' and 'address'."
        },
        "selector": {
          "$ref": "#/definitions/selector",
          "description": "Derivation input for generated layer names. Only valid on kind 'layer'."
        },
        "attributes": {
          "$ref": "#/definitions/attribute-map"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "layer"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "name"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "semantics"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "table": {
                "const": "semantics"
              },
              "selector": false,
              "name": false
            },
            "required": [
              "table"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "address"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "table": {
                "const": "address"
              },
              "selector": false,
              "name": false
            },
            "required": [
              "table"
            ]
          }
        }
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cityObjectType",
        "geometryFamily",
        "lod"
      ],
      "properties": {
        "cityObjectType": {
          "type": "string",
          "minLength": 1
        },
        "geometryFamily": {
          "type": "string",
          "minLength": 1
        },
        "lod": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Input of the layer-name derivation, e.g. {cityObjectType: BuildingPart, geometryFamily: MultiSurface, lod: 2.2} -> buildingpart_multisurface_lod2_2. Cross-file tests verify that the declared name matches the expansion."
    },
    "attribute-map": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/definitions/attribute-entry"
      }
    },
    "attribute-entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "column": {
          "type": "string",
          "minLength": 1,
          "description": "Column name. Defaults to the semantic attribute name when absent."
        },
        "type": {
          "type": "string",
          "enum": [
            "TEXT",
            "INTEGER",
            "FLOAT",
            "REAL",
            "BOOLEAN",
            "DATE",
            "DATETIME"
          ],
          "description": "GeoPackage/SQLite column data type. Arrays are stored as TEXT (JSON)."
        }
      }
    }
  }
}
